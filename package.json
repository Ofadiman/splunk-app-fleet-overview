{
  "name": "fleet-overview",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-pages.mjs --watch",
    "build": "tsc -b && node scripts/build-pages.mjs",
    "package": "pnpm run build && node scripts/package-app.mjs",
    "eslint": "eslint src",
    "eslint:fix": "eslint src --fix",
    "lint": "pnpm run eslint && pnpm run stylelint",
    "stylelint": "stylelint \"src/**/*.{ts,tsx,js,jsx}\" --config stylelint.config.cjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,json}\"",
    "format:verify": "prettier --list-different \"src/**/*.{ts,tsx,js,jsx,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@splunk/react-icons": "^5.16.0",
    "@splunk/react-page": "^8.5.0",
    "@splunk/react-ui": "^5.17.0",
    "@splunk/splunk-utils": "^4.2.0",
    "@splunk/themes": "^1.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "styled-components": "^5.3.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@splunk/eslint-config": "^6.0.0",
    "@splunk/stylelint-config": "^5.1.0",
    "@swc/plugin-styled-components": "^13.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.6.2",
    "stylelint": "^15.11.0",
    "tar": "^7.5.22",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.3.0"
}
