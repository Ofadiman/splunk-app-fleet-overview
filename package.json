{
  "name": "fleet-overview",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#component-tests": "./src/testing/vitestRuntime.ts",
    "#original-splunk-line": "@splunk/visualizations/Line",
    "#original-splunk-column": "@splunk/visualizations/Column"
  },
  "scripts": {
    "dev": "node scripts/build.ts --watch",
    "build": "tsc -b && node scripts/build.ts",
    "package": "pnpm run build && node scripts/package.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,json}\"",
    "format:verify": "prettier --list-different \"src/**/*.{ts,tsx,js,jsx,css,json}\"",
    "test:vitest:chrome": "vitest run --project=chrome",
    "test:vitest:edge": "vitest run --project=edge",
    "test:vitest:firefox": "vitest run --project=firefox",
    "test:vitest:webkit": "vitest run --project=webkit",
    "test:vitest:coverage": "FLEET_TEST_COVERAGE=true vitest run --project=chrome",
    "test:cypress:chrome": "cypress run --component --browser=chrome",
    "test:cypress:edge": "cypress run --component --browser=edge",
    "test:cypress:firefox": "cypress run --component --browser=firefox",
    "test:cypress:webkit": "cypress run --component --browser=webkit --config=experimentalWebKitSupport=true,injectDocumentDomain=true",
    "test:cypress:coverage": "FLEET_TEST_COVERAGE=true cypress run --component --browser=chrome",
    "test:coverage": "pnpm test:vitest:coverage && pnpm test:cypress:coverage && node scripts/compareTestCoverage.ts",
    "simulate": "node scripts/simulate.ts"
  },
  "dependencies": {
    "@splunk/moment": "^0.7.0",
    "@splunk/react-icons": "^5.16.0",
    "@splunk/react-page": "^8.5.0",
    "@splunk/react-time-range": "^12.1.2",
    "@splunk/react-ui": "^5.17.0",
    "@splunk/splunk-utils": "^4.2.0",
    "@splunk/themes": "^1.13.0",
    "@splunk/time-range-utils": "^3.4.1",
    "@splunk/ui-utils": "^1.15.0",
    "@splunk/visualization-context": "^28.10.0",
    "@splunk/visualizations": "^28.10.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.1.6",
    "react-is": "^18.3.1",
    "styled-components": "^5.3.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@swc/plugin-styled-components": "^13.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/expect": "5.1.1",
    "@vitest/spy": "5.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "cypress": "^16.3.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "ora": "^10.0.0",
    "playwright": "^1.65.1",
    "playwright-webkit": "1.61.0",
    "prettier": "^3.6.2",
    "tar": "^7.5.22",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
